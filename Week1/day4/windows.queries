//ROW_NUMBER()

select * from employees;

1.	Assign a unique row number to all employees based on salary (highest first). 

SELECT *,
ROW_NUMBER() OVER(ORDER BY salary DESC) AS rownumber
FROM employees;

2.Assign row numbers to employees within each department based on salary descending. 

select *,row_number() over(partition by department order by salary desc) as rownumber
from employees;

3.	Assign row numbers based on employee joining date (latest first). 
select *,
row_number() over (order by join_date desc) as rownumber
from employees;

4.	Assign row numbers within each department based on earliest joining date. 
select *,
row_number() over(partition by department order by join_date desc) as rownumber
from employees;

5.	Assign row numbers to orders based on order date. 
select *,
row_number() over(order by join_date) as row_num
from employees;

6.	Assign row numbers to orders within each city based on order amount (highest first). 
select *,
row_number() over(partition by department order by join_date desc) as rownumber
from employees;

7.	Assign row numbers to employees based on salary (lowest first). 
select *,
row_number() over( order by salary asc) as rownumber
from employees;

8.	Assign row numbers within department for employees based on name alphabetically. 
select *,
row_number() over(partition by department order by emp_name asc) as rownumber
from employees;

//RANK()
select * from employees;

9.	Rank all employees based on salary (highest first). 
select *,
rank() over (order by salary desc)as ranknumber
from employees;

10.	Rank employees within each department based on salary. 
select *,
rank() over (partition by department order by salary ) as ranks
from employees;

11.	Rank employees based on joining date (latest gets rank 1). 
select *,
rank() over(order by join_date desc) as ranked
from employees;

12.	Rank orders based on order amount (highest first). 
select *,
rank()over(order by salary desc) as ranker
from employees;

13.	Rank orders within each city based on order amount. 
select *,
rank() over(partition by department
order by join_date) as rankeds
from employees;

14.	Rank employees within department based on salary (lowest first). 
select *,
rank() over(partition by department order by salary asc) as low
from employees;

15.	Rank employees based on name alphabetically. 
select *,
rank() over(order by emp_name desc) as rankeddd
from employees;

16.	Rank orders within each city based on order date
select *,
rank() over(partition by department
order by join_date) as rankeds
from employees;

//DENSE_RANK()
select * from employees;

select *,
dense_rank() over (order by salary desc) from employees;

select *,
dense_rank() over(partition by department order by salary) as ranked
from employees;

select *,
dense_rank() over(order by join_date) as ranked
from employees;

select *,
dense_rank() over( order by salary) as ranked
from employees;

select *,
dense_rank() over(partition by department order by salary) as ranked
from employees;

select *,
dense_rank() over( order by salary asc) as ranked
from employees;

select *,
dense_rank() over(partition by department order by join_date) as ranked
from employees;

select *,
dense_rank() over( order by join_date) as ranked
from employees;








